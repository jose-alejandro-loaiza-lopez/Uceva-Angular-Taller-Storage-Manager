{
  "name": "angular-storage-manager-workspace",
  "version": "0.0.0",
  "description": "Workspace de la librería @josefo_pro/angular-storage-manager y su aplicación Showcase.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:lib && npm run build:app",
    "build:lib": "ng build angular-storage-manager",
    "build:lib:dev": "ng build angular-storage-manager --watch",
    "build:app": "ng build",
    "build:dev": "npm run build:lib:dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "compodoc": "npx compodoc -p tsconfig.doc.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.35",
    "@compodoc/compodoc": "^1.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-html-reporters": "^3.1.7",
    "jest-preset-angular": "^15.0.3",
    "ng-packagr": "^20.3.0",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.2"
  }
}
